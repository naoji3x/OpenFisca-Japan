{
  "name": "openfisca-japan-dashboard",
  "private": true,
  "version": "0.0.0",
  "scripts": {
    "dev": "vite --port 30000 --host 0.0.0.0",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:stories": "vitest run --config vitest.browser.config.mts --project storybook",
    "test:browser": "vitest run --config vitest.browser.config.mts --project browser",
    "test:ui": "vitest run --config vitest.browser.config.mts",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "build": "tsc && vite build",
    "preview": "vite preview --port 30000 --host 0.0.0.0",
    "test:e2e": "playwright test",
    "lint": "eslint src",
    "pretty": "prettier --write --ignore-unknown .",
    "pretty:check": "prettier --check --ignore-unknown .",
    "prepare": "cd .. && husky dashboard/.husky"
  },
  "dependencies": {
    "@chakra-ui/icons": "^2.0.19",
    "@chakra-ui/react": "^2.7.1",
    "@emotion/react": "^11.11.1",
    "@emotion/styled": "^11.11.0",
    "@xstate/react": "^6.1.0",
    "framer-motion": "^10.12.17",
    "html-to-image": "^1.11.11",
    "pako": "^2.1.0",
    "qrcode.react": "^4.2.0",
    "react": "^18.3.1",
    "react-device-detect": "^2.2.3",
    "react-dom": "^18.3.1",
    "react-icons": "^4.10.1",
    "react-router-dom": "^6.30.6",
    "recoil": "^0.7.7",
    "xstate": "^5.26.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.64.1",
    "@storybook/addon-a11y": "^10.6.5",
    "@storybook/addon-vitest": "^10.6.5",
    "@storybook/react-vite": "^10.6.5",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^22.20.5",
    "@types/pako": "^2.0.3",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/browser": "^5.0.5",
    "@vitest/browser-playwright": "^5.0.5",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react": "^7.37.5",
    "globals": "^17.13.0",
    "husky": "^9.1.7",
    "jsdom": "^30.1.3",
    "msw": "^2.15.0",
    "msw-storybook-addon": "^3.0.3",
    "playwright": "^1.64.1",
    "prettier": "3.0.3",
    "storybook": "^10.6.5",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "vitest-browser-react": "^2.3.0"
  }
}
